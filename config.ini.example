[device]
; Folder where current.json, current.js, history.csv (and weather.html) are written.
; Sync this folder to your cloud storage — OneDrive, Google Drive, Dropbox, etc.
; Share the folder publicly and use that URL to access weather.html.
write_path = ~/AcuRite

[sensors]
; Map your sensor IDs to display names. Hub sensor IDs are listed on the hub's
; local page (http://<hub IP>/), e.g.  00005358 = Kitchen
; Run:  python3 acurite-capture.py --discover
; to find your sensor IDs. Then add them here.
;
; 1234 = Backyard
; 5678 = Garage
; 9012 = Roof

[hub]
; AcuRite Access 09155M hub relay. The hub reports each reading over HTTPS to
; the "Server Name" on its local page (http://<hub IP>/). Point that at this
; machine and the daemon records every reading, then passes it on to AcuRite
; unchanged, so the AcuRite app keeps working. Weather Underground is sent by
; the hub itself and is untouched.
;
;   point the hub here:   curl -d 'ser=<this machine IP>' http://<hub IP>/config.cgi
;   put it back:          curl -d 'ser=atlasapi.myacurite.com' http://<hub IP>/config.cgi
;
; Port 443 needs CAP_NET_BIND_SERVICE (the systemd unit grants it).
port = 443
tls = true
; Pass every reading on to AcuRite and return AcuRite's answer to the hub.
relay = true
relay_url = https://atlasapi.myacurite.com
; Only record readings from this hub (Device ID on its local page). Set it if
; port 443 is reachable from outside.
; hub_id = 24C86E0B0000   (yours is on the hub's local page as its MAC)
; Self-signed certificate is generated here on first run.
; cert_dir = ~/.acurite-free
; Every raw hub request, one file per day, for re-processing later.
; raw_dir = ~/.acurite-free/hub-raw

[web]
; Built-in web server for the dashboard: serves weather.html, current.js,
; current.json and history.csv, read-only, nothing else. To reach it from
; outside, forward a port on your router to this one (e.g. outside 80 -> 12345).
; Several ports are allowed, comma-separated: routers that can only forward a
; port to the same number (Xfinity) need 80 listed here, e.g. port = 12345, 80
enabled = false
port = 12345

[weather_underground]
; station_id alone adds a Weather Underground pane (your station's page:
; forecast, sun/moon, history) to the bottom of the dashboard. Leave it unset
; and the pane is not shown. The pane opens WU's station dashboard; pane_url
; swaps in any other WU page (e.g. your town's page, which has the forecast).
; station_id = YOUR_WU_STATION_ID
; pane_url = https://www.wunderground.com/weather/us/<state>/<town>/YOUR_WU_STATION_ID
; Uploading to WU from this program: only for the rtl_433 capture path. An
; Access hub uploads to WU itself, so leave this off with a hub.
enabled = false
; station_key = YOUR_WU_STATION_KEY

[capture]
; Radio capture with a USB SDR and rtl_433. Off unless you have the dongle.
enabled = false

; RTL-SDR device index (0 = first dongle found).
device_index = 0

; AcuRite protocol numbers recognised by rtl_433.
; 40  = AcuRite 5-in-1 / 00899 / Atlas (earlier firmware)
; 78  = AcuRite 592TXR Tower sensor (temp + humidity only)
; 112 = AcuRite 00275rm
; 191 = AcuRite Atlas (later firmware)
; Add more if you have other AcuRite devices — see: rtl_433 -R help
protocols = 40,78,112,191
