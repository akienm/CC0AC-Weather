[device]
; Folder where current.json, current.js, history.csv (and weather.html) are written.
; Sync this folder to your cloud storage — OneDrive, Google Drive, Dropbox, etc.
; Share the folder publicly and use that URL to access weather.html.
write_path = ~/AcuRite

[sensors]
; Map your sensor IDs to display names. Hub sensor IDs are listed on the hub's
; local page (http://<hub IP>/), e.g.  00005358 = Kitchen
; Run:  python3 acurite-capture.py --discover
; to find your sensor IDs. Then add them here.
;
; 1234 = Backyard
; 5678 = Garage
; 9012 = Roof

[sensor_order]
; The order sensors are shown in, on every page: number = sensor ID.
; Sensors not listed come after, by name.
; 1 = 5678
; 2 = 1234

[outdoor_rows]
; The order of the rows on the outdoor (Atlas, 5-in-1) card: number = row.
; Rows not listed follow in this usual order:
;   feels_like, humidity, dew_point, wind, gust, pressure, rain_today,
;   rain_rate, uv, light, lightning, last_strike
; 1 = wind
; 2 = gust

[sensor_rows]
; The same for the other sensors' cards. Rows: humidity, dew_point
; 1 = dew_point

[hub]
; AcuRite Access 09155M hub relay. The hub reports each reading over HTTPS to
; the "Server Name" on its local page (http://<hub IP>/). Point that at this
; machine and the daemon records every reading, then passes it on to AcuRite
; unchanged, so the AcuRite app keeps working. Weather Underground is sent by
; the hub itself and is untouched.
;
; The README shows two ways: change the hub's server name to a hostname that
; reaches this machine (it takes a name, not an IP address, and every field must
; be sent or its Weather Underground settings are blanked), or plug the hub into
; this machine and answer atlasapi.myacurite.com locally.
;
; Port 443 needs CAP_NET_BIND_SERVICE (the boot loader grants it on Linux).
; enabled = false turns the relay off, for a station with no AcuRite hub.
enabled = true
port = 443
tls = true
; Pass every reading on to AcuRite and return AcuRite's answer to the hub.
relay = true
relay_url = https://atlasapi.myacurite.com
; Only record readings from this hub (Device ID on its local page). Set it if
; port 443 is reachable from outside.
; hub_id = 24C86E0B0000   (yours is on the hub's local page as its MAC)
; Self-signed certificate is generated here on first run.
; cert_dir = ~/.cc0ac-weather
; Every raw hub request, one file per day, for re-processing later.
; raw_dir = ~/.cc0ac-weather/hub-raw

[storage]
; Every hub reading is kept in a SQLite database (one row per sensor reading,
; plus the hub's whole request). Default: weather.db in write_path. The web
; server never serves it. To load readings from before it existed, out of the
; raw hub logs:  python3 acurite-capture.py --import-raw
; database = ~/AcuRite/weather.db

[web]
; Built-in web server for the dashboard: serves weather.html, charts.html,
; theme.css and the data files, and on your own network /config.cgi, a page for
; editing this file (no password yet). To reach it from outside, forward a port
; on your router to this one (e.g. outside 80 -> 12345); outside visitors get
; only the dashboard and the charts.
; Several ports are allowed, comma-separated: routers that can only forward a
; port to the same number (Xfinity) need 80 listed here, e.g. port = 12345, 80
enabled = false
port = 12345
; A folder of your own pages, stylesheets and images, served by name. A file
; named like a shipped one (theme.css, weather.html, charts.html) replaces it, so
; copy theme.css here to change the colors. Updates never touch this folder.
; pages = ~/.cc0ac-weather/pages

[updates]
; Whether the station installs security fixes and small repairs by itself
; (UPDATES.md). yes: security fixes are checked daily at this time (plus a few
; minutes picked at install), repairs and new versions once a week. no: it's an
; appliance; nothing is ever downloaded.
automatic = yes
time = 06:00

[backup]
; Once a week, at the update time, the settings, the readings database and
; history.csv are copied to this place as one .tar.gz, and the newest `keep` are
; kept. Blank: no backup. A folder (/mnt/nas/weather, D:\Backups\weather), or a
; Windows share: \\server\share\folder. On Linux and macOS a share is reached
; with smbclient using user and password (user may be DOMAIN\name; blank user:
; no password). On Windows the share is used directly, as you are logged in.
; The disks' health is checked every day whether or not this is set.
path =
user =
password =
keep = 8

[buttons]
; A row of buttons in a pane at the bottom of the dashboard. Each loads its page
; into the pane: a radar map, a forecast, a webcam, anything that lets itself be
; framed. buttonN = Label | URL, shown in number order. A blank one is not shown,
; so you can keep spare slots. None set, and there is no pane.
; Logging in to a site inside the pane needs the browser to allow third-party
; cookies for the dashboard's address (in Chrome: the eye icon in the address bar).
; Or add  | Target=<name>  and the button opens its page in a browser window of
; that name instead, where logging in just works; pressing it again reuses that
; window. Target=_blank opens a new tab every time.
;   button2 = Weather Underground | https://www.wunderground.com/ | Target=wu
button1 = Radar | https://www.wunderground.com/wundermap?lat=<lat>&lon=<lon>&zoom=12&radar=true
button2 =
button3 =

[station]
; The station's name, shown in the heading and browser tab of every page.
; name = CC0AC Weather
;
; Where the station is. With latitude and longitude set, the dashboard shows
; sunrise, sunset, day length and the moon phase, all computed in the page with
; no outside service. Degrees, north and east positive (west is negative).
; elevation_ft is shown on the card.
; latitude = 32.0
; longitude = -108.0
; elevation_ft = 6000

[weather_underground]
; Station ID and key: only for uploading from this program (below).
; station_id = YOUR_WU_STATION_ID
; Uploading to WU from this program: only for the rtl_433 capture path. An
; Access hub uploads to WU itself, so leave this off with a hub.
enabled = false
; station_key = YOUR_WU_STATION_KEY

[mqtt]
; Publish every reading to an MQTT broker, for Home Assistant and the like.
; Each field goes to <topic>/<sensor_id>/<field>, retained. MQTT 3.1.1, no TLS:
; for a broker on your own network.
enabled = false
host =
port = 1883
; username =
; password =
topic = cc0ac-weather
; Home Assistant's MQTT discovery: each sensor appears as a device by itself,
; named as in [sensors], one entity per field.
discovery = true
discovery_prefix = homeassistant

[forecast]
; Forecast, nearest-airport visibility and clouds, and active alerts from the
; US National Weather Service (api.weather.gov; free, no key, US only). Uses
; [station] latitude and longitude. Writes forecast.json and forecast.js beside
; current.json; the dashboard shows them as an hourly strip, a 7-day list, two
; rows on the sun & moon card and a banner while an alert is active.
; Outside the US the hourly strip and 7-day list come from Open-Meteo
; (open-meteo.com; free, no key, worldwide); it has no alerts or airport sky.
enabled = false
; auto = the Weather Service where it covers the location, else Open-Meteo.
; Or name one: nws, open-meteo.
source = auto

; The Weather Service asks every caller to name itself with a way to reach
; them (sent in the User-Agent). A website or an email address.
contact = github.com/akienm/CC0AC-Weather

[online]
; Outdoor readings from the internet, for a house with no weather station (a
; spare tablet on the wall makes a weather display) or as a second opinion. Uses
; [station] latitude and longitude.
;   nws        the National Weather Service's nearest observing station, usually
;              an airport a few miles away (US only); a real measurement, hourly
;   open-meteo Open-Meteo's current conditions for your exact spot (worldwide);
;              a weather model's estimate, every 15 minutes
;   auto       the Weather Service where it covers the location, else Open-Meteo
; It shows as one more outdoor sensor; name it under [sensors] if you like
; (its ID is open-meteo, or nws- and the station, e.g. nws-kbjc).
enabled = false
source = auto

[alerts]
; A message when readings stop, and another when they come back. Checked every
; 5 minutes by its own timer (cc0ac-weather-check.timer, which setup/install-pi.sh
; installs; or run  python3 acurite-capture.py --check  from cron), so it still
; speaks up if this program itself has died. The setup page (/setup) fills
; this in; test with  python3 acurite-capture.py --test-alert
enabled = false
; How long without a reading before a message goes out (the hub sends every 5).
quiet_minutes = 30
;
; ntfy (ntfy.sh): a free phone app. Subscribe in the app to a topic nobody else
; would guess, and put the same name here.
; ntfy_topic = weather-3f9a51c07e2d
; ntfy_server = https://ntfy.sh
;
; Email, through a mail server that takes a login. For Gmail: smtp.gmail.com,
; port 587, and an app password (not your normal one).
; email_to = you@example.com
; email_from =
; smtp_host = smtp.gmail.com
; smtp_port = 587
; smtp_user = you@gmail.com
; smtp_password =
;
; A dead-man's switch such as healthchecks.io, for when the whole Pi goes off,
; which nothing on the Pi can report: pinged while readings come in, and
; <url>/fail when they stop. When the pings stop, the service tells you.
; healthcheck_url = https://hc-ping.com/your-check-id

[console]
; A station console or WiFi gateway that can upload to a "custom server":
; Ambient Weather (awnet app, "Customized"), Ecowitt and Fine Offset relabels
; (WS View app or the gateway's web page, "Customized"), or anything that speaks
; Weather Underground's upload format. Set the console's server to this
; machine's address, this port, and any path (Ambient's app wants it to end in
; "?"); protocol Ecowitt, Ambient Weather or Wunderground all work. The console
; keeps uploading to its own cloud too. Not yet tested on real hardware: see
; SUPPORTED.md, and send --diagnostics if it misreads anything.
enabled = false
port = 12346

; If set, only uploads from this console are recorded: its MAC, PASSKEY or
; Weather Underground station ID, as shown in console-raw/ beside this file.
; station =

; Readings appear as console-outdoor, console-indoor and console-ch1..ch8;
; name them under [sensors] like any other.

[capture]
; Radio capture with a USB SDR and rtl_433. Off unless you have the dongle.
enabled = false

; RTL-SDR device index (0 = first dongle found).
device_index = 0

; rtl_433 protocol numbers to decode (rtl_433 25.02's numbering; `rtl_433 -R help`
; lists them all, and the numbers can change between rtl_433 versions).
; 40 = AcuRite Atlas, Iris, 5-in-1, 3-in-1, 592TXR tower and room sensors,
;      515 fridge/freezer, 6045 lightning, 899 rain gauge
; 74 = AcuRite 00275rm and 00276rm
; Other brands: SUPPORTED.md lists their numbers. protocols = all lets rtl_433
; use its own default set, which is handy with --discover to see what's near.
protocols = 40,74

; Radio frequency. Unset = 433.92M (AcuRite, and most brands' older or European
; 433 MHz sensors). North American Ambient/Ecowitt/Fine Offset gear is 915M;
; European is 868M. With two or more (comma-separated), the radio switches
; between them every hop_seconds and misses whatever is sent on the other one
; meanwhile; a second dongle is the clean way to hear two bands.
; frequency = 915M
; hop_seconds = 30

; Decode recordings (.cu8 files, comma-separated) instead of the dongle, then
; stop: for testing without the radio. Leave unset for normal use.
; read = ~/samples/atlas.cu8, ~/samples/tower.cu8

; Only sensors listed under [sensors] are recorded; with none listed, every
; sensor heard is recorded, the neighbours' too. Use --discover to find IDs.
